{
  "name": "omrani-gym",
  "version": "2.0.4",
  "private": true,
  "description": "Groundwork: beginner strength training, weekly plans and progress tracking",
  "main": "src/server.js",
  "scripts": {
    "dev": "concurrently -k -n server,vite \"node --watch src/server.js\" \"vite --configLoader runner\"",
    "build": "vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "start": "node src/server.js",
    "seed": "node scripts/seed.js",
    "bootstrap": "node scripts/bootstrap.js",
    "check": "node --check src/server.js && node --check src/app.js && vite build --configLoader runner",
    "build:apk": "node scripts/build-apk.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "concurrently": "^9.2.1",
    "vite": "^7.1.12"
  }
}
