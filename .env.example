NODE_ENV=production
HOST=127.0.0.1
PORT=14000
# Public URL(s) of the site, comma separated. Write requests from any other origin are rejected in production.
APP_ORIGIN=https://gym.omranisystems.com
# URL-encode special characters in the password (@ -> %40).
MONGO_URI=mongodb://gym_user:CHANGE_ME@127.0.0.1:27017/omrani_gym?authSource=omrani_gym
# At least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters
# One-time: create the first administrator with `npm run bootstrap`, then delete these two lines.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-one-time-password
